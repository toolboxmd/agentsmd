{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/toolboxmd/agentsmd/v8.6.0/schemas/delivery-v1.schema.json",
  "title": "ToolboxMD Delivery Profile v1",
  "description": "Project-specific Delivery System v1 deltas. Canonical version, Project Record, release policy, and documentation truth remain in their owning files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema"
  ],
  "anyOf": [
    {"required": ["commands"]},
    {"required": ["artifact"]},
    {"required": ["website"]}
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/toolboxmd/agentsmd/v8.6.0/schemas/delivery-v1.schema.json"
    },
    "schema": {
      "const": 1
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "changedScope": {"$ref": "#/$defs/commands"},
        "complete": {"$ref": "#/$defs/commands"},
        "release": {
          "allOf": [
            {"$ref": "#/$defs/commands"},
            {
              "contains": {"type": "string", "pattern": "\\{sha\\}"},
              "minContains": 1
            }
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "output", "digest"],
      "properties": {
        "build": {
          "type": "string",
          "allOf": [
            {"pattern": "\\{sha\\}"},
            {"pattern": "\\{version\\}"}
          ]
        },
        "output": {
          "type": "string",
          "allOf": [
            {"pattern": "^dist/[A-Za-z0-9._{}/-]+$"},
            {"pattern": "\\{version\\}"}
          ]
        },
        "digest": {"const": "sha256"}
      }
    },
    "website": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "baseUrl", "route"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "baseUrl": {
          "type": "string",
          "pattern": "^https://[^/?#]+$"
        },
        "route": {
          "type": "string",
          "pattern": "^/(?:[A-Za-z0-9._~-]+/?)*$"
        }
      }
    }
  },
  "$defs": {
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n\\u0000]+$"
      }
    }
  }
}
