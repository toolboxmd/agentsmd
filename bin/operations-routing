#!/usr/bin/env python3
"""Point a new session at the operations Skill (Claude Code, OpenCode).

Emits one SessionStart hook object whose additional context tells the model to
open `skills/operations/SKILL.md` beside this file before the first edit,
commit, Issue or PR. Issue #174 measured this short pointer against injecting
the whole routing table: it reached the target procedure as often or more on
Claude Code and OpenCode at a fraction of the context. Codex and Grok load the
Skill themselves and do not run this command.
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

SKILL = Path(__file__).resolve().parents[1] / "skills/operations/SKILL.md"


def context() -> str:
    if not SKILL.is_file():
        return (
            f"AgentsMD could not find the operations Skill at {SKILL}. "
            "Invoke the operations Skill before the first edit."
        )
    return (
        "AgentsMD: at the start of every task, before its first tool call, invoke the `operations` "
        f"Skill (or read {SKILL}) and read the procedure its routing table links for the next "
        "action: researching, an experiment, reproducing a defect, the first file edit, a commit, "
        "a GitHub Issue or a pull request. Do this for small tasks and questions too; it takes one read.\n"
    )


def main() -> int:
    json.dump(
        {
            "hookSpecificOutput": {
                "hookEventName": "SessionStart",
                "additionalContext": context(),
            }
        },
        sys.stdout,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
