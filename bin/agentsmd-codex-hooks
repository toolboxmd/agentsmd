#!/usr/bin/env python3
"""Check or record Codex trust for the AgentsMD plugin hooks.

Run `trust` after installing or updating the plugin in Codex: Codex skips a
plugin hook until both its definition and content hashes are recorded."""

from __future__ import annotations

import argparse
import json
import sys

from agentsmd_codex_hooks import CodexUnavailable, inspect, trust


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("status", "trust"))
    args = parser.parse_args(argv)
    try:
        result = trust() if args.command == "trust" else inspect()
    except CodexUnavailable as error:
        result = {"healthy": False, "status": "codex-unavailable", "detail": str(error)}
    if args.command == "trust" and result.get("status") == "none-listed":
        result.update(healthy=False, action="Install the plugin with `codex plugin add agentsmd@toolboxmd`, then rerun.")
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if result["healthy"] else 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
