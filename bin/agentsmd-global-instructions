#!/usr/bin/env python3
"""Inspect and safely install the global AgentsMD instruction link."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import sys
import uuid
from datetime import UTC, datetime
from pathlib import Path
from typing import Any


def absolute(path: str | Path) -> Path:
    return Path(os.path.abspath(os.path.expanduser(str(path))))


def default_target() -> Path:
    codex_home = os.environ.get("CODEX_HOME")
    root = absolute(codex_home) if codex_home else Path.home() / ".codex"
    return root / "AGENTS.md"


def is_cache_path(path: Path) -> bool:
    parts = path.parts
    return any(
        parts[index : index + 2] == ("plugins", "cache")
        for index in range(len(parts) - 1)
    )


def target_location(target: Path) -> Path:
    return target.parent.resolve(strict=False) / target.name


def target_is_in_cache(target: Path) -> bool:
    return is_cache_path(target) or is_cache_path(target_location(target))


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def inspect_target(target: Path) -> dict[str, Any]:
    report: dict[str, Any] = {
        "target": str(target),
        "healthy": False,
        "status": "missing",
    }
    if target_is_in_cache(target):
        report["status"] = "cache-bound-target"
        return report
    if not os.path.lexists(target):
        return report
    if not target.is_symlink():
        report["status"] = "non-symlink"
        report["target_kind"] = "directory" if target.is_dir() else "file"
        return report

    link_target = os.readlink(target)
    linked = Path(link_target)
    linked_path = absolute(linked if linked.is_absolute() else target.parent / linked)
    resolved = linked_path.resolve(strict=False)
    report.update(
        {
            "link_target": link_target,
            "resolved_target": str(resolved),
            "target_kind": "symlink",
        }
    )
    if is_cache_path(linked_path) or is_cache_path(resolved):
        report["status"] = "cache-bound-link"
        return report
    if not resolved.is_file():
        report["status"] = "broken-link"
        return report
    if resolved.name != "AGENTS.md":
        report["status"] = "invalid-link-target"
        return report

    target_digest = digest(resolved)
    report.update(
        {
            "healthy": True,
            "sha256": target_digest,
            "status": "valid-stable-link",
            "target_sha256": target_digest,
        }
    )
    return report


def emit(report: dict[str, Any], exit_code: int) -> int:
    print(json.dumps(report, indent=2, sort_keys=True))
    return exit_code


def validate_source(source: Path) -> tuple[Path | None, dict[str, Any] | None]:
    if is_cache_path(source):
        return None, {
            "error": "cache-bound-source",
            "source": str(source),
        }
    try:
        resolved = source.resolve(strict=True)
    except FileNotFoundError:
        return None, {"error": "missing-source", "source": str(source)}
    if is_cache_path(resolved):
        return None, {
            "error": "cache-bound-source",
            "source": str(source),
            "resolved_source": str(resolved),
        }
    if not resolved.is_file():
        return None, {"error": "invalid-source", "source": str(source)}
    if resolved.name != "AGENTS.md":
        return None, {
            "error": "invalid-source-name",
            "source": str(source),
            "resolved_source": str(resolved),
        }
    return resolved, None


def next_backup_path(target: Path, backup_dir: Path) -> Path:
    stamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%S.%fZ")
    candidate = backup_dir / f"{target.name}.{stamp}.bak"
    counter = 1
    while os.path.lexists(candidate):
        candidate = backup_dir / f"{target.name}.{stamp}.{counter}.bak"
        counter += 1
    return candidate


def back_up(target: Path, backup_dir: Path) -> Path:
    backup_dir.mkdir(parents=True, exist_ok=True)
    backup = next_backup_path(target, backup_dir)
    if target.is_symlink():
        link_target = Path(os.readlink(target))
        linked_path = absolute(
            link_target if link_target.is_absolute() else target.parent / link_target
        )
        backup.symlink_to(linked_path.resolve(strict=False))
    elif target.is_file():
        shutil.copy2(target, backup)
    else:
        raise ValueError("unsupported target type")
    return backup


def install(
    source: Path,
    target: Path,
    replace: bool,
    backup_dir: Path | None,
) -> int:
    resolved_source, source_error = validate_source(source)
    if source_error:
        return emit(source_error, 2)
    assert resolved_source is not None

    if target_is_in_cache(target):
        return emit(
            {
                "error": "cache-bound-target",
                "source": str(resolved_source),
                "target": str(target),
            },
            2,
        )
    if target_location(target) == resolved_source:
        return emit(
            {
                "error": "source-equals-target",
                "source": str(resolved_source),
                "target": str(target),
            },
            2,
        )

    before = inspect_target(target)
    if (
        before["status"] == "valid-stable-link"
        and Path(str(before["resolved_target"])).resolve() == resolved_source
    ):
        return emit(
            {
                **before,
                "action": "unchanged",
                "source": str(resolved_source),
                "source_sha256": digest(resolved_source),
            },
            0,
        )

    exists = os.path.lexists(target)
    if exists and not replace:
        return emit(
            {
                "error": "replacement-required",
                "previous_status": before["status"],
                "source": str(resolved_source),
                "target": str(target),
            },
            2,
        )
    if exists and not (target.is_symlink() or target.is_file()):
        return emit(
            {
                "error": "unsupported-target",
                "previous_status": before["status"],
                "target": str(target),
            },
            2,
        )

    target.parent.mkdir(parents=True, exist_ok=True)
    backup: Path | None = None
    if exists:
        backup = back_up(
            target,
            backup_dir or target.parent / "agentsmd-backups",
        )

    temporary = target.parent / f".{target.name}.agentsmd-{uuid.uuid4().hex}"
    try:
        temporary.symlink_to(resolved_source)
        os.replace(temporary, target)
    finally:
        if os.path.lexists(temporary):
            temporary.unlink()

    after = inspect_target(target)
    if (
        after["status"] != "valid-stable-link"
        or Path(str(after["resolved_target"])).resolve() != resolved_source
    ):
        return emit(
            {
                "error": "post-install-verification-failed",
                "inspection": after,
            },
            2,
        )
    return emit(
        {
            **after,
            "action": "repaired" if exists else "installed",
            "backup": str(backup) if backup else None,
            "previous_status": before["status"],
            "source": str(resolved_source),
            "source_sha256": digest(resolved_source),
        },
        0,
    )


def parser() -> argparse.ArgumentParser:
    command = argparse.ArgumentParser(
        description="Inspect or install the global AgentsMD instruction link."
    )
    subcommands = command.add_subparsers(dest="command", required=True)

    inspect_command = subcommands.add_parser(
        "inspect", help="Report whether a global instruction target is healthy."
    )
    inspect_command.add_argument("--target", type=absolute, default=default_target())

    install_command = subcommands.add_parser(
        "install", help="Install or repair a stable global instruction link."
    )
    install_command.add_argument("--source", type=absolute, required=True)
    install_command.add_argument("--target", type=absolute, default=default_target())
    install_command.add_argument(
        "--replace",
        action="store_true",
        help="Authorize replacement after preserving the existing target.",
    )
    install_command.add_argument(
        "--backup-dir",
        type=absolute,
        help="Directory for the preserved previous target.",
    )
    return command


def main() -> int:
    arguments = parser().parse_args()
    try:
        if arguments.command == "inspect":
            report = inspect_target(arguments.target)
            return emit(report, 0 if report["healthy"] else 2)
        return install(
            arguments.source,
            arguments.target,
            arguments.replace,
            arguments.backup_dir,
        )
    except (OSError, ValueError) as error:
        return emit({"error": "io-error", "message": str(error)}, 2)


if __name__ == "__main__":
    sys.exit(main())
