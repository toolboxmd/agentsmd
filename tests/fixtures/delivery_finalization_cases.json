  "terminal-cases": [
    {
      "id": "merged",
      "disposition": "merged",
      "review-complete": true,
      "disposition-verified": true,
      "expected-decision": "begin-finalization"
    },
    {
      "id": "approved-alternative-delivery",
      "disposition": "approved-alternative-delivery",
      "review-complete": true,
      "disposition-verified": true,
      "expected-decision": "begin-finalization"
    },
    {
      "id": "cancelled",
      "disposition": "cancelled",
      "review-complete": true,
      "disposition-verified": true,
      "expected-decision": "begin-finalization"
    },
    {
      "id": "duplicated",
      "disposition": "duplicated",
      "review-complete": true,
      "disposition-verified": true,
      "expected-decision": "begin-finalization"
