      "names_first_unblocked_issue": true,
      "starts_implementation": true,
      "starts_in_fresh_context": true
    },
    {
      "branch": "explicit-parent-only",
      "implementation_authorized": false,
      "parent_only": true,
      "transitions": [
        "draft-parent",
        "approve-parent",
        "publish-and-verify-parent",
        "complete-parent-only"
      ],
      "terminal_state": "parent-only-complete",
      "implementation_authority_prompts": 0,
      "names_first_unblocked_issue": false,
      "starts_implementation": false,
      "starts_in_fresh_context": false
    },
    {
      "branch": "revised-drafts",
      "implementation_authorized": false,
      "parent_only": false,
      "transitions": [
        "draft-parent",
        "revise-parent-draft",
        "approve-parent",
        "publish-and-verify-parent",
        "draft-tickets",
        "revise-ticket-draft",
        "approve-ticket-graph",
