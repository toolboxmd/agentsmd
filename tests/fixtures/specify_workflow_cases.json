    {
      "branch": "rejected-ticket-draft",
      "implementation_authorized": false,
      "parent_only": false,
      "transitions": [
        "draft-parent",
        "approve-parent",
        "publish-and-verify-parent",
        "draft-tickets",
        "reject-ticket-draft",
        "stop-without-ticket-publication"
      ],
      "terminal_state": "ticket-draft-rejected",
      "implementation_authority_prompts": 0,
      "names_first_unblocked_issue": false,
      "starts_implementation": false,
      "starts_in_fresh_context": false
