      "names_first_unblocked_issue": true,
      "starts_implementation": false,
      "starts_in_fresh_context": false
    },
    {
      "branch": "pre-authorized-implementation",
      "implementation_authorized": true,
      "parent_only": false,
      "transitions": [
        "draft-parent",
        "approve-parent",
        "publish-and-verify-parent",
        "draft-tickets",
        "approve-ticket-graph",
        "publish-and-verify-tickets",
        "start-first-unblocked-issue-in-fresh-context"
