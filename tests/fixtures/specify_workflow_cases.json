{
  "schema": 1,
  "contract": {
    "workflow": "specify",
    "default_completion": "verified-ticket-publication",
    "parent_publication_approval": "required",
    "ticket_publication_approval": "required",
    "parent_only_opt_out": "supported",
    "entry_skill": "to-spec",
    "entry_invocation": "model",
    "implementation_authority_source": "full-current-request",
